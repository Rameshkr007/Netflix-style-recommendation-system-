# Copy this file to .env and fill in real values before deploying anywhere
# beyond your own machine. Never commit the real .env file.

ENVIRONMENT=development
DEBUG=true

# --- Database (overridden automatically by docker-compose.yml for the api service) ---
DATABASE_URL=postgresql://postgres:ramesh2003@localhost/netflix_ai

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
# Generate a real secret with: openssl rand -hex 32
JWT_SECRET_KEY=01f79b1c38111483743783212e166668403e45f838d95dd9b35f551d14d2c8e0
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Google OAuth (optional, required only for /auth/google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120

# --- CORS: comma-separated list is NOT supported here; edit app/core/config.py
# directly for multiple origins, or set via JSON-style env if your shell supports it.
